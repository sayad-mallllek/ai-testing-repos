# Local development credentials. Keep these aligned with DATABASE_URL.
POSTGRES_USER=ai_lab
POSTGRES_PASSWORD=ai_lab_dev
POSTGRES_DB=ai_lab
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://ai_lab:ai_lab_dev@localhost:55432/ai_lab
SQL_ECHO=false
# The store, seed script and local RAG work without this key; chat requires it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_HISTORY_TURNS=8
AGENT_HISTORY_CHARS=60000
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_TIMEOUT_SECONDS=120
MODEL_TIMEOUT_SECONDS=30
SEARCH_TIMEOUT_SECONDS=10
